{
  "name": "stitch",
  "displayName": "Stitch: SVN & Git File History",
  "description": "See who changed a file, when and why. Works with SVN and Git, no svn install needed.",
  "version": "0.0.8",
  "publisher": "bscan",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bscan/stitch.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "keywords": [
    "svn",
    "subversion",
    "git",
    "history",
    "file history",
    "log",
    "diff"
  ],
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "stitch.history",
          "name": "Stitch History"
        }
      ]
    },
    "commands": [
      {
        "command": "stitch.openChanges",
        "title": "Open Changes",
        "category": "Stitch",
        "icon": "$(diff)"
      },
      {
        "command": "stitch.revertChange",
        "title": "Revert Change",
        "category": "Stitch",
        "icon": "$(discard)"
      },
      {
        "command": "stitch.refresh",
        "title": "Refresh",
        "category": "Stitch",
        "icon": "$(refresh)"
      },
      {
        "command": "stitch.fetch",
        "title": "Fetch",
        "category": "Stitch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "stitch.pickRef",
        "title": "Choose Starting Branch…",
        "category": "Stitch",
        "icon": "$(git-branch)"
      },
      {
        "command": "stitch.loadMore",
        "title": "Load More",
        "category": "Stitch"
      },
      {
        "command": "stitch.diffWithPrevious",
        "title": "Diff with Previous",
        "category": "Stitch"
      },
      {
        "command": "stitch.diffFile",
        "title": "Diff File with Previous",
        "category": "Stitch"
      },
      {
        "command": "stitch.diffWithWorking",
        "title": "Diff with Working File",
        "category": "Stitch"
      },
      {
        "command": "stitch.openRevision",
        "title": "Open This Revision",
        "category": "Stitch"
      },
      {
        "command": "stitch.copyRevision",
        "title": "Copy Revision",
        "category": "Stitch"
      },
      {
        "command": "stitch.copyDiff",
        "title": "Copy Diff",
        "category": "Stitch"
      },
      {
        "command": "stitch.showHistory",
        "title": "Stitch: Show History",
        "icon": "$(history)"
      },
      {
        "command": "stitch.showGitHistory",
        "title": "Stitch: Show Git History",
        "icon": "$(history)"
      },
      {
        "command": "stitch.showSvnHistory",
        "title": "Stitch: Show SVN History",
        "icon": "$(history)"
      },
      {
        "command": "stitch.filter",
        "title": "Scope and Filters…",
        "category": "Stitch",
        "icon": "$(filter)"
      },
      {
        "command": "stitch.filterActive",
        "title": "Scope and Filters… (filtered)",
        "category": "Stitch",
        "icon": "$(filter-filled)"
      },
      {
        "command": "stitch.clear",
        "title": "Clear Scope and Filters",
        "category": "Stitch",
        "icon": "$(close)"
      },
      {
        "command": "stitch.onlyAuthor",
        "title": "Only This Author",
        "category": "Stitch"
      },
      {
        "command": "stitch.openCommit",
        "title": "Open Changes",
        "category": "Stitch"
      },
      {
        "command": "stitch.searchFurther",
        "title": "Search Further",
        "category": "Stitch",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stitch.filter",
          "when": "view == stitch.history && !stitch.filtered",
          "group": "navigation@0"
        },
        {
          "command": "stitch.filterActive",
          "when": "view == stitch.history && stitch.filtered",
          "group": "navigation@0"
        },
        {
          "command": "stitch.clear",
          "when": "view == stitch.history && stitch.held",
          "group": "navigation@1"
        },
        {
          "command": "stitch.pickRef",
          "when": "view == stitch.history && stitch.kind == git",
          "group": "navigation@2"
        },
        {
          "command": "stitch.fetch",
          "when": "view == stitch.history && stitch.kind == git && stitch.canFetch && isWorkspaceTrusted",
          "group": "navigation@3"
        },
        {
          "command": "stitch.refresh",
          "when": "view == stitch.history",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "stitch.diffWithPrevious",
          "when": "view == stitch.history && viewItem =~ /^stitch\\.(commit|merge)/",
          "group": "1_diff@1"
        },
        {
          "command": "stitch.diffWithWorking",
          "when": "view == stitch.history && viewItem =~ /^stitch\\.(commit|merge)/",
          "group": "1_diff@2"
        },
        {
          "command": "stitch.openRevision",
          "when": "view == stitch.history && viewItem =~ /^stitch\\.(commit|merge)/",
          "group": "2_open@1"
        },
        {
          "command": "stitch.copyRevision",
          "when": "view == stitch.history && viewItem =~ /^stitch\\.(scoped\\.)?(commit|merge)$/",
          "group": "3_copy@1"
        },
        {
          "command": "stitch.copyDiff",
          "when": "view == stitch.history && viewItem =~ /^stitch\\.(commit|merge|file)$/",
          "group": "3_copy@2"
        },
        {
          "command": "stitch.onlyAuthor",
          "when": "view == stitch.history && viewItem =~ /^stitch\\.(scoped\\.)?(commit|merge)$/",
          "group": "4_filter@1"
        },
        {
          "command": "stitch.searchFurther",
          "when": "view == stitch.history && viewItem == stitch.further",
          "group": "inline@1"
        },
        {
          "command": "stitch.clear",
          "when": "view == stitch.history && viewItem =~ /^stitch\\.(clearable|further)$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "stitch.openChanges",
          "when": "stitch.kind == svn"
        },
        {
          "command": "stitch.revertChange",
          "when": "false"
        },
        {
          "command": "stitch.loadMore",
          "when": "false"
        },
        {
          "command": "stitch.diffWithPrevious",
          "when": "false"
        },
        {
          "command": "stitch.diffWithWorking",
          "when": "false"
        },
        {
          "command": "stitch.openRevision",
          "when": "false"
        },
        {
          "command": "stitch.copyRevision",
          "when": "false"
        },
        {
          "command": "stitch.diffFile",
          "when": "false"
        },
        {
          "command": "stitch.copyDiff",
          "when": "false"
        },
        {
          "command": "stitch.fetch",
          "when": "stitch.canFetch && isWorkspaceTrusted"
        },
        {
          "command": "stitch.filterActive",
          "when": "false"
        },
        {
          "command": "stitch.clear",
          "when": "stitch.held"
        },
        {
          "command": "stitch.onlyAuthor",
          "when": "false"
        },
        {
          "command": "stitch.openCommit",
          "when": "false"
        },
        {
          "command": "stitch.searchFurther",
          "when": "false"
        },
        {
          "command": "stitch.showGitHistory",
          "when": "false"
        },
        {
          "command": "stitch.showSvnHistory",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "stitch.openChanges",
          "when": "stitch.svnModified && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "scm/change/title": [
        {
          "command": "stitch.revertChange",
          "when": "originalResourceScheme == stitch"
        }
      ],
      "editor/context": [
        {
          "command": "stitch.showGitHistory",
          "when": "resourceScheme == file && stitch.editorKind == git",
          "group": "navigation@100"
        },
        {
          "command": "stitch.showSvnHistory",
          "when": "resourceScheme == file && stitch.editorKind == svn",
          "group": "navigation@100"
        },
        {
          "command": "stitch.showHistory",
          "when": "resourceScheme == file && !stitch.editorKind",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "stitch.showHistory",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Stitch",
      "properties": {
        "stitch.svn.urlMap": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "machine",
          "markdownDescription": "Maps `svn://` (or `svn+ssh://`) repository URLs to the http(s) URLs history is read from. Prefixes match whole path segments, longest first, and the target's repository UUID must match the working copy's. Example: `{ \"svn://svn\": \"http://svn/repos\" }` maps `svn://svn/project` to `http://svn/repos/project`."
        },
        "stitch.svn.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "Minimum seconds between automatic SVN server queries for the same file: switching back to a file or refocusing the window within this time reuses its loaded history, and a failed server isn't asked again until it passes. **Refresh** always queries. Merge checks are done once per file per session regardless."
        },
        "stitch.git.path": {
          "type": "string",
          "default": "git",
          "scope": "machine",
          "description": "Path to the git executable."
        },
        "stitch.logLimit": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "description": "Number of history entries loaded per page."
        },
        "stitch.timeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Timeout for each git command and each SVN server request, in milliseconds."
        },
        "stitch.git.fetchExcludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/drives/",
            "/mnt/",
            "/smb"
          ],
          "scope": "machine",
          "markdownDescription": "The **Fetch** button isn't offered for repositories under these folders (matched as whole path segments: `/smb` covers `/smb/x`, not `/smbx`). On Linux, repositories on a network file system (`cifs`, `nfs`, `sshfs`, …, from `/proc/mounts`) are excluded too."
        },
        "stitch.git.fetchLocalDrives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "C:",
            "D:"
          ],
          "scope": "machine",
          "markdownDescription": "Windows: the drives that are local disks. The **Fetch** button is only offered for repositories on these drives (never on UNC paths like `\\\\server\\share`)."
        },
        "stitch.history.follow": {
          "type": "string",
          "enum": [
            "file",
            "workingCopy"
          ],
          "default": "file",
          "enumDescriptions": [
            "The history of the file in the active editor.",
            "The whole history of the active file's working copy (git repository or SVN checkout)."
          ],
          "markdownDescription": "What **Stitch History** shows while it follows the editor (no scope or filter chosen): the active file's history, or the full log of its working copy."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts src/svn/wcdbWorker.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --sourcemap --outdir=dist --entry-names=[name]",
    "watch": "esbuild src/extension.ts src/svn/wcdbWorker.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --sourcemap --outdir=dist --entry-names=[name] --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p tsconfig.test.json && mocha --timeout 60000 'out/test/**/*.test.js'",
    "vscode:prepublish": "npm run build -- --minify",
    "package": "vsce package --no-dependencies --out dist/"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.34",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.2",
    "mocha": "10.8.2",
    "typescript": "5.7.2"
  }
}
